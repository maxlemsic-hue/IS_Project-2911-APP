// Catalog and customer ordering models.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Provenance for a planning estimate, never a verified actual acquisition cost.
enum ProductCostBasis {
  REVERSE_CALCULATED_ESTIMATE
  MANUAL_ESTIMATE
}

enum OrderSource {
  ONLINE
  WALK_IN
}

enum OrderStatus {
  PENDING_REVIEW
  IN_REVIEW
  AVAILABLE_FOR_CONFIRMATION
  DECLINED
  AWAITING_PAYMENT
  ACCEPTED
  PROCESSING
  READY
  COMPLETED
}

enum OrderMessageSender {
  CUSTOMER
  ADMIN
}

enum ReceiptStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum StaffRole {
  OWNER_ADMIN
  CASHIER
  PRODUCTION
}

enum StaffAction {
  REVIEW_STARTED
  ORDER_AVAILABLE
  ORDER_DECLINED
  ORDER_ACCEPTED
  RECEIPT_APPROVED
  RECEIPT_REJECTED
  ADMIN_REPLY
  PRODUCTION_ASSIGNED
  PRODUCTION_UNASSIGNED
  PRODUCTION_STARTED
  ORDER_READY
  ORDER_COMPLETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_ARCHIVED
  PRODUCT_IMAGE_ADDED
  PRODUCT_IMAGE_REMOVED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_ARCHIVED
  WALK_IN_CREATED
}

model StaffUser {
  id           String          @id @default(uuid()) @db.Uuid
  username     String          @unique
  displayName  String
  passwordHash String
  role         StaffRole
  active       Boolean         @default(true)
  sessions     StaffSession[]
  assigned     CustomerOrder[]
  actions      StaffAudit[]
  createdOrders CustomerOrder[] @relation("OrderCreator")
}

model StaffSession {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffUserId])
}

model StaffAudit {
  id          String          @id @default(uuid()) @db.Uuid
  staffUserId String          @db.Uuid
  orderId     String?         @db.Uuid
  productId   String?         @db.Uuid
  categoryId  String?         @db.Uuid
  receiptId   String?         @db.Uuid
  action      StaffAction
  occurredAt  DateTime        @default(now()) @db.Timestamptz(3)
  staffUser   StaffUser       @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order       CustomerOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receipt     PaymentReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([productId, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([orderId, occurredAt])
  @@index([staffUserId])
  @@index([receiptId])
}

enum OrderNotificationKind {
  ORDER_AVAILABLE
  RECEIPT_APPROVED
  RECEIPT_REJECTED
  ORDER_ACCEPTED
  PRODUCTION_STARTED
  ORDER_READY
  ORDER_COMPLETED
  ADMIN_REPLY
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?   @db.Text
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  products Product[]
  staffActions StaffAudit[]
}

model Product {
  id                   String                   @id @default(uuid()) @db.Uuid
  categoryId           String                   @db.Uuid
  // Assigned by the migration's BEFORE INSERT trigger; immutable on UPDATE.
  sku                  String                   @unique @default(dbgenerated())
  name                 String
  slug                 String                   @unique
  description          String?                  @db.Text
  specificationText    String?                  @db.Text
  unitPrice            Decimal                  @db.Decimal(18, 4)
  minimumOrderQuantity Int                      @default(1)
  estimatedUnitCost    Decimal?                 @db.Decimal(18, 4)
  costBasis            ProductCostBasis?
  sellingUnitLabel     String                   @default("piece")
  publicationStatus    ProductPublicationStatus @default(DRAFT)
  isAvailable          Boolean                  @default(false)
  version              Int                      @default(1)
  archivedAt           DateTime?                @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)

  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attributes ProductAttribute[]
  orderItems OrderItem[]
  images ProductImage[]
  staffActions StaffAudit[]

  @@index([categoryId])
}

model CustomerOrder {
  id                String              @id @default(uuid()) @db.Uuid
  reference         String              @unique
  // ONLINE is the native default in the walk-in migration.
  source            OrderSource         @default(dbgenerated("('ONLINE'::text)::\"OrderSource\""))
  createdById       String?             @db.Uuid
  createdBy         StaffUser?          @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accessHash        String
  customerName      String
  contactPhone      String
  status            OrderStatus         @default(PENDING_REVIEW)
  declineReason     String?
  confirmedAt       DateTime?           @db.Timestamptz(3)
  acceptedAt        DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  items             OrderItem[]
  messages          OrderMessage[]
  receipts          PaymentReceipt[]
  statusChanges     OrderStatusChange[]
  notifications     OrderNotification[]
  productionStaffId String?             @db.Uuid
  productionStaff   StaffUser?          @relation(fields: [productionStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staffActions      StaffAudit[]

  @@index([productionStaffId])
  @@index([createdById])
}

model OrderNotification {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String                @db.Uuid
  kind      OrderNotificationKind
  eventId   String                @db.Uuid
  createdAt DateTime              @default(now()) @db.Timestamptz(3)
  readAt    DateTime?             @db.Timestamptz(3)
  order     CustomerOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([orderId, kind, eventId])
  @@index([orderId, createdAt])
}

model OrderStatusChange {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @db.Uuid
  fromStatus OrderStatus
  toStatus   OrderStatus
  occurredAt DateTime      @default(now()) @db.Timestamptz(3)
  order      CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([orderId, toStatus])
}

model OrderMessage {
  id        String             @id @default(uuid()) @db.Uuid
  orderId   String             @db.Uuid
  sender    OrderMessageSender
  text      String
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  order     CustomerOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId, createdAt])
}

model PaymentReceipt {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @db.Uuid
  content          Bytes
  contentType      String
  imageHash        String        @unique
  status           ReceiptStatus @default(PENDING_VERIFICATION)
  paymentReference String?       @unique
  amount           Decimal?      @db.Decimal(30, 2)
  rejectionReason  String?
  submittedAt      DateTime      @default(now()) @db.Timestamptz(3)
  verifiedAt       DateTime?     @db.Timestamptz(3)
  order            CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staffActions     StaffAudit[]

  @@index([orderId, submittedAt])
}

model OrderItem {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  productId   String        @db.Uuid
  productName String
  productSku  String
  sellingUnit String
  quantity    Int
  unitPrice   Decimal       @db.Decimal(18, 4)
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId])
  @@index([productId])
}

model ProductAttribute {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  key       String
  label     String
  value     String   @db.Text
  unit      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productId, key])
}


model ProductImage {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  altText     String
  contentType String
  content     Bytes
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([productId, createdAt])
}
