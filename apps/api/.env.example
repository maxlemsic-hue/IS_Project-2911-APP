# Local development only. Use a dedicated non-superuser role; URL-encode the password.
# Runtime adapter uses DATABASE_URL; Prisma CLI prefers DIRECT_URL.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/twenty9_eleven?schema=public"
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/twenty9_eleven?schema=public"
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4201
